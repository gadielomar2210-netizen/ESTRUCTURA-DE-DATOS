def leer_lista():
    print("Ingresa los números separados por espacio (ejemplo: 5 2 9 1 3):")
    while True:
        entrada = input("Lista: ")
        partes = entrada.split()
        try:
            lista = [int(x) for x in partes]
            return lista
        except ValueError:
            print("Error: solo se permiten números enteros. Intenta de nuevo.\n")


# ----------------- MÉTODO BURBUJA -----------------
def burbuja(lista):
    n = len(lista)
    # Hacemos una copia para no modificar la lista original
    arr = lista.copy()
    for i in range(n - 1):
        for j in range(n - 1 - i):
            if arr[j] > arr[j + 1]:
                # Intercambio
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
    return arr


