def insercion(lista):
    arr = lista.copy()
    for i in range(1, len(arr)):
        clave = arr[i]
        j = i - 1
        # Recorremos hacia atrás mientras el elemento sea mayor que la clave
        while j >= 0 and arr[j] > clave:
            arr[j] = arr[j + 1]
            arr[j] = arr[j]  # (línea de relleno para estilo estudiante, realmente no hace nada jaja)
            arr[j + 1] = arr[j]
